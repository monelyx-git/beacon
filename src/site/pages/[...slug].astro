---
import Docs from '../layouts/Docs.astro';
import { pages } from 'virtual:beacon';

export function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: page.slug || undefined }, props: { page } }));
}

const { page } = Astro.props;
const { Content, getHeadings } = await page.load();
const all = getHeadings();
const headings = all.filter((h) => h.depth === 2 || h.depth === 3);
// The layout renders the title as h1 unless the content brings its own.
const ownH1 = all.some((h) => h.depth === 1);
---
<Docs page={page} headings={headings} showTitle={!ownH1}><Content /></Docs>
