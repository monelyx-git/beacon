---
import Docs from '../layouts/Docs.astro';
import { withBase } from '../lib/nav.js';
import { t } from '../lib/strings.js';
import { locales } from 'virtual:beacon';

const s = t(locales[0]);
// No `rel`: the 404 has no translations, so the switcher links to each locale's home.
const page = { slug: '404', file: '', title: s.notFoundTitle, description: s.notFoundDescription, locale: locales[0] };
---
<Docs page={page} headings={[]} showTitle={true} notFound={true}>
  <p>{s.notFoundBody} <a href={withBase('/')}>{s.notFoundHome}</a> {s.notFoundRest}</p>
</Docs>
