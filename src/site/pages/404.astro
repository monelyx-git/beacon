---
import Docs from '../layouts/Docs.astro';
import { withBase } from '../lib/nav.js';

const page = { slug: '404', file: '', title: 'Page not found', description: 'This page does not exist.' };
---
<Docs page={page} headings={[]} showTitle={true} notFound={true}>
  <p>The page you were looking for does not exist or has moved. <a href={withBase('/')}>Go to the home page</a> or pick a page from the sidebar.</p>
</Docs>
