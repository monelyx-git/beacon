---
import '@fontsource-variable/bricolage-grotesque';
import latinFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import { config, nav, pages } from 'virtual:beacon';
import { themeScript } from '../lib/theme-script.js';
import { rewriteLinks } from '../../cli/links.js';
import { wrapCodeBlocks } from '../lib/code-blocks.js';
import { trail, withBase } from '../lib/nav.js';

const { page, headings, showTitle } = Astro.props;
const href = page.slug ? `/${page.slug}/` : '/';
const crumbs = trail(nav, href).slice(0, -1);
// Only override Pier's own (theme-aware) accent when the config changes it.
const accent = config.accent !== '#d2441c' ? `--beacon-accent:${config.accent}` : undefined;
const heading = page.title;
const description = page.description ?? config.title;
const canonical = `${config.site}${href}`;
const title = heading === config.title ? heading : `${heading} · ${config.title}`;
const body = wrapCodeBlocks(rewriteLinks(await Astro.slots.render('default'), page.file, pages, { base: import.meta.env.BASE_URL }));
---
<!doctype html>
<html lang="en" style={accent}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.title} />
    <meta property="og:title" content={heading} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${config.site}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="font" type="font/woff2" href={latinFont} crossorigin />
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href={withBase('/')}>
          {config.logo && <img src={withBase(config.logo)} alt="" width="24" height="24" />}
          <span>{config.title}</span>
        </a>
        <button type="button" class="theme-toggle" aria-label="Toggle theme">◐</button>
        <nav aria-label="Documentation"><Sidebar nodes={nav} current={href} /></nav>
      </aside>
      <main class="content">
        {crumbs.length > 0 && <p class="crumbs">{crumbs.map((c) => c.label).join(' / ')}</p>}
        {showTitle && <h1>{heading}</h1>}
        <article class="prose" set:html={body} />
      </main>
      <Toc headings={headings} />
    </div>
    <script>
      import { handleCopyClick } from '../lib/copy.js';
      import { toggleTheme } from '../lib/theme-toggle.js';
      // Wrapper so a blocked localStorage throws inside toggleTheme's try, not at property access.
      const storage = { setItem: (k, v) => localStorage.setItem(k, v) };
      document.addEventListener('click', (e) => {
        handleCopyClick(e, navigator.clipboard, setTimeout);
        if (e.target.closest?.('.theme-toggle')) toggleTheme(document, storage);
      });
    </script>
  </body>
</html>
