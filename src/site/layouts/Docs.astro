---
import '@fontsource-variable/bricolage-grotesque';
import latinFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { config, navs, locales, pages, assets, contentDir } from 'virtual:beacon';
import { themeScript } from '../lib/theme-script.js';
import { rewriteLinks } from '../../cli/links.js';
import { wrapCodeBlocks } from '../lib/code-blocks.js';
import { anchorHeadings } from '../lib/anchors.js';
import { siblings, trail, withBase } from '../lib/nav.js';
import { t } from '../lib/strings.js';
import { mdPath } from '../../cli/content.js';
import { editHref } from '../../cli/edit-link.js';
import { alternates, homeHref, switcherLinks } from '../../cli/locales.js';

const { page, headings, showTitle, notFound = false } = Astro.props;
const href = page.slug ? `/${page.slug}/` : '/';
const { locale } = page;
const s = t(locale);
const nav = navs[locale];
const { prev, next } = siblings(nav, href);
const crumbs = trail(nav, href).slice(0, -1);
// Only override Pier's own (theme-aware) accent when the config changes it.
const accent = config.accent !== '#d2441c' ? `--beacon-accent:${config.accent}` : undefined;
const heading = page.title;
const description = page.description ?? config.title;
const canonical = `${config.site}${href}`;
const title = heading === config.title ? heading : `${heading} · ${config.title}`;
const body = anchorHeadings(wrapCodeBlocks(rewriteLinks(await Astro.slots.render('default'), page.file, pages, { base: import.meta.env.BASE_URL, assets: new Set(assets), contentDir }), s), s.anchor);
---
<!doctype html>
<html lang={locale} style={accent}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {config.favicon && <link rel="icon" href={withBase(config.favicon)} />}
    <meta name="description" content={description} />
    {notFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {alternates(pages, page, locales).map((a) => <link rel="alternate" hreflang={a.hreflang} href={config.site + a.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.title} />
    <meta property="og:title" content={heading} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${config.site}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="font" type="font/woff2" href={latinFont} crossorigin />
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <div class="shell">
      <button type="button" class="sidebar-toggle" aria-controls="sidebar" aria-expanded="true" aria-label={s.toggleSidebar}>⟨</button>
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-head">
          <a class="brand" href={withBase(homeHref(locale, locales))} aria-label={config.logoHtml ? config.title : undefined}>
            {config.logoHtml ? <Fragment set:html={config.logoHtml} /> : <>
              {config.logo && <img src={withBase(config.logo)} alt="" width="24" height="24" />}
              <span>{config.title}</span>
            </>}
          </a>
          <button type="button" class="theme-toggle" aria-label={s.toggleTheme}>◐</button>
        </div>
        <button type="button" class="search-open" aria-label={s.search} aria-keyshortcuts="Control+K Meta+K">{s.search} <kbd>⌘K</kbd></button>
        <nav aria-label={s.navLabel}><Sidebar nodes={nav} current={href} collapsible={config.collapsibleSidebar} /></nav>
        {locales.length > 1 && <LangSwitch links={switcherLinks(pages, page, locales)} />}
      </aside>
      <main class="content" data-pagefind-body={notFound ? undefined : ''}>
        <div class="meta-row">
          {crumbs.length > 0 && <p class="crumbs">{crumbs.map((c) => c.label).join(' / ')}</p>}
          {!notFound && <button type="button" class="copy-page" data-md={withBase(`/${mdPath(page.slug)}`)} data-copy={s.copyPage} data-copied={s.copied} data-failed={s.copyFailed} aria-live="polite" data-pagefind-ignore>{s.copyPage}</button>}
        </div>
        {showTitle && <h1>{heading}</h1>}
        <article class="prose" set:html={body} />
        {config.editUrl && page.file && <p class="edit" data-pagefind-ignore><a href={editHref(config.editUrl, contentDir, page.file)}>{s.editPage}</a></p>}
        {(prev || next) && (
          <nav class="pager" aria-label={s.pager} data-pagefind-ignore>
            {prev ? <a class="prev" href={withBase(prev.href)} rel="prev"><small>{s.previous}</small>{prev.label}</a> : <span />}
            {next ? <a class="next" href={withBase(next.href)} rel="next"><small>{s.next}</small>{next.label}</a> : <span />}
          </nav>
        )}
      </main>
      <Toc headings={headings} label={s.toc} />
    </div>
    <script>
      import { handleCopyClick, handlePageCopyClick } from '../lib/copy.js';
      import { toggleTheme } from '../lib/theme-toggle.js';
      import { toggleSidebar, isSidebarShortcut } from '../lib/sidebar-toggle.js';
      // Wrapper so a blocked localStorage throws inside toggleTheme's try, not at property access.
      const storage = { setItem: (k, v) => localStorage.setItem(k, v) };
      // Search code (Preact, dialog, Pagefind) is fetched only when search is first opened.
      const openSearch = async () => (await import('../lib/search-mount.jsx')).openSearch(import.meta.env.BASE_URL);
      // The inline head script already applied the saved state; sync the button to it.
      document.querySelector('.sidebar-toggle')?.setAttribute('aria-expanded', String(!document.documentElement.classList.contains('sidebar-hidden')));
      document.addEventListener('keydown', (e) => {
        if (isSidebarShortcut(e)) toggleSidebar(document, storage);
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openSearch(); }
      });
      document.addEventListener('click', (e) => {
        if (e.target.closest?.('.search-open')) openSearch();
        handleCopyClick(e, navigator.clipboard, setTimeout);
        handlePageCopyClick(e, { fetch, clipboard: navigator.clipboard, ClipboardItem: globalThis.ClipboardItem }, setTimeout);
        if (e.target.closest?.('.theme-toggle')) toggleTheme(document, storage);
        if (e.target.closest?.('.sidebar-toggle')) toggleSidebar(document, storage);
      });
    </script>
  </body>
</html>
