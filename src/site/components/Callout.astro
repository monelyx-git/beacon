---
import { t } from '../lib/strings.js';

const { type = 'note', title } = Astro.props;
const labels = t(Astro.locals.locale);
---
<aside class={`callout callout-${type}`} role="note" aria-label={title ?? labels[type]}>
  <p class="callout-title">{title ?? labels[type]}</p>
  <div class="callout-body"><slot /></div>
</aside>
