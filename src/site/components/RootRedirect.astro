---
import { config } from 'virtual:beacon';
import { withBase } from '../lib/nav.js';
import { t } from '../lib/strings.js';

const { to, locale } = Astro.props;
const url = withBase(to);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{config.title}</title>
    <meta http-equiv="refresh" content={`0; url=${url}`} />
    <link rel="canonical" href={`${config.site}${to}`} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>{t(locale).redirecting} <a href={url}>{url}</a>…</p>
    <script is:inline define:vars={{ url }}>location.replace(url);</script>
  </body>
</html>
