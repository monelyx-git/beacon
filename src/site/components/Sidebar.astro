---
import { withBase, trail } from '../lib/nav.js';
// depth 0 folders are always-open sections (title, pages below); deeper folders collapse when `collapsible`.
const { nodes, current, collapsible = false, depth = 0 } = Astro.props;
---
<ul>
  {nodes.map((n) => {
    const label = n.href ? <a href={withBase(n.href)} aria-current={n.href === current ? 'page' : undefined}>{n.label}</a> : <span class="group">{n.label}</span>;
    const children = n.children.length > 0 && <Astro.self nodes={n.children} current={current} collapsible={collapsible} depth={depth + 1} />;
    // shortcut: a nested folder with its own page keeps that link inside <summary> (two tab stops), upgrade if a11y audits flag it.
    return n.children.length > 0 && depth === 0
      ? <li class="section">{label}{children}</li>
      : <li>
          {collapsible && n.children.length > 0
            ? <details open={trail([n], current).length > 0}><summary>{label}</summary>{children}</details>
            : <>{label}{children}</>}
        </li>;
  })}
</ul>
