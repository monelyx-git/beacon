---
import { withBase, trail } from '../lib/nav.js';
const { nodes, current, collapsible = false } = Astro.props;
---
<ul>
  {nodes.map((n) => {
    const label = n.href ? <a href={withBase(n.href)} aria-current={n.href === current ? 'page' : undefined}>{n.label}</a> : <span class="group">{n.label}</span>;
    const children = n.children.length > 0 && <Astro.self nodes={n.children} current={current} collapsible={collapsible} />;
    return (
      <li>
        {collapsible && n.children.length > 0
          ? <details open={trail([n], current).length > 0}><summary>{label}</summary>{children}</details>
          : <>{label}{children}</>}
      </li>
    );
  })}
</ul>
