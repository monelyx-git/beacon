---
const { headings, label } = Astro.props;
---
{headings.length > 0 && (
  <nav aria-label={label} class="toc">
    <p class="toc-title">{label}</p>
    <ul>
      {headings.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
    </ul>
  </nav>
)}
<script>
  import { spy } from '../lib/toc-spy.js';
  spy(document, document, window.IntersectionObserver);
</script>
